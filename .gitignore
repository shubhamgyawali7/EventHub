# Ignore everything
*

# Allow required files/folders
!.gitignore
!README.md
!client/
!server/

# Allow all contents inside client and server
!client/**
!server/**

# Node modules
node_modules/
server/node_modules/
client/node_modules/

# Environment variables
.env
server/.env
client/.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
client/build/

# Dependency directories
jspm_packages/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
