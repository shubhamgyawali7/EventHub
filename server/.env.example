# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/eventhub

# Authentication
JWT_SECRET=your_jwt_secret_here

# Khalti Payment Gateway
KHALTI_SECRET_KEY=your_khalti_secret_key_here

# eSewa Payment Gateway
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key_here
ESEWA_API_URL=https://rc-epay.esewa.com.np/api/epay
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_CLIENT_ID=your_esewa_client_id
ESEWA_CLIENT_SECRET=your_esewa_client_secret

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=EventHub <support@yourdomain.com>

# Email Service (Nodemailer - optional)
EMAIL_PROVIDER=resend
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
